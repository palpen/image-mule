{
  "name": "image-mule",
  "version": "1.1.0",
  "description": "Haul screenshots to your remote server via SFTP",
  "author": "palpen",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "jest"
  },
  "build": {
    "appId": "com.image-mule.app",
    "productName": "Image Mule",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-confirm.js",
      "lib/**/*.js",
      "renderer/**/*",
      "LICENSE",
      "!**/node_modules/cpu-features/**/*",
      "!**/node_modules/ssh2/lib/protocol/crypto/build/**/*"
    ],
    "artifactName": "Image-Mule-${version}-${os}-${arch}.${ext}",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "npmRebuild": false
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "ssh2-sftp-client": "^9.1.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "jest": "30.5.2"
  }
}
